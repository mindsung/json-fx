{
  "name": "@mindsung/json-fx",
  "version": "1.0.2",
  "type": "commonjs",
  "description": "JSON-fx: a query and transform engine for JavaScript. Templates are JSON; strings are expressions; compiled to fast JavaScript.",
  "keywords": [
    "javascript",
    "json",
    "templating",
    "template",
    "transform",
    "query",
    "expressions"
  ],
  "homepage": "https://github.com/mindsung/json-fx/tree/develop/json-fx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindsung/json-fx.git",
    "directory": "json-fx"
  },
  "license": "MIT",
  "author": {
    "name": "Aaron Eads"
  },
  "contributors": [
    {
      "name": "Robb Eads"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "json-fx": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:package": "tsx scripts/test-package.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "bench": "tsx bench/run.ts",
    "compare": "tsx bench/compare.ts",
    "check": "tsx src/cli/main.ts check",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:package"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.20.5",
    "crypto-js": "^4.2.0",
    "json-fx-v0": "npm:@mindsung/json-fx@0.1.25",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
