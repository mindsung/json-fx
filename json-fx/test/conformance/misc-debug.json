{
  "defaults": {
    "source": "misc-debug.spec.ts",
    "tags": ["script", "reduce", "recursion"],
    "inputs": { "$": { "a": [
      { "b": [{ "c": [1, 2, 3, 4] }, { "c": [1, 2, 3] }] },
      { "b": [{ "c": null }, { "c": [1, 2, 3] }, { "c": [1, 2, 3, 4, 5, 6] }, { "c": [1, null, 3, 4] }] }
    ] } }
  },
  "cases": [
    {"name": "misc-debug: nested reducers with user functions as arguments", "template": {"@addValues($items, $accumValue, @valueExpr)": {"@reducer($total, $item)": {"$itemTotal": "ifElse($item != null, @valueExpr($item, $total), 0)", "()": "ifElse($itemTotal != null, log('total:', $total) + log('add:', $itemTotal), log('no-add-total', $total))"}, "()": "log('reduce result:', log('accum:', $accumValue) + $items?:reduce(@reducer, $accumValue))"}, "@countLevel2($a, $prevValue)": "@addValues($a.b, $prevValue, $n => 1)", "()": "@addValues($.a, 0, @countLevel2)"}, "expect": 10, "v0": "differs", "change": "B", "bug": "B2", "note": "The v0 spec expects 5, but that expectation is wrong (V1-PLAN.md §3.5): a direct JS translation returns 10 because `$accumValue` is added twice. v0 returns 4 (clobbered shared lambda scope).", "v0Actual": 4},
    {"name": "misc-debug: reduce totals with null-safe accumulators", "template": {"@addTotals($t1, $t2)": "{ count: ($t1?.count || 0) + ($t2?.count || 0), sum: ($t1?.sum || 0) + ($t2?.sum || 0) }", "@totalCs($cs)": "$cs?:reduce(($total, $c) => @addTotals($total, ifElse($c != null, { count: 1, sum: $c })))", "@totalBs($bs)": "$bs?:reduce(($total, $b) => @addTotals($total, ifElse($b != null, @totalCs($b?.c))))", "()": "$.a?:reduce(($total, $a) => @addTotals($total, ifElse($a != null, @totalBs($a?.b))))"}, "expect": {"count": 19, "sum": 51}, "v0": "same"}
  ]
}
