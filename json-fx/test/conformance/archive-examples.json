{
  "defaults": { "v0": "same", "tags": ["example"] },
  "cases": [
    {"name": "example 01-basic: properties and operators", "template": {"//": "Simple properties, operators", "$": {"a": 10, "b": 20, "c": "hello"}, "prop": "$.a", "math-ops": {"add": "$.a + $.b", "subtract": "$.a - $.b", "multiply": "$.a * $.b", "divide": "$.a / $.b", "text-concat": "$.c + ' ' + $.a + ' ' + $.b"}}, "expect": {"prop": 10, "math-ops": {"add": 30, "subtract": -10, "multiply": 200, "divide": 0.5, "text-concat": "hello 10 20"}}, "source": "archive/examples/json/01-basic.fx.json (-expect keys folded into expect)", "note": "relies on the bare word `hello` being a string constant (V1-PLAN.md §4.4)"},
    {"name": "example 02-arrays: collection functions", "template": {"$": {"numbers": [2, 4, 6, 8, 10, 11, 13, 15, 17, 19], "words": ["orange", "grape", "apple", "berry", "lemon", "bricks", "watermelon"]}, "length": "$.words:length()", "min-number": "$.numbers:min()", "min-word": "$.words:min()", "find-number": "$.numbers:find($n => $n > 10)", "find-word": "$.words:find($w => $w:toUpperCase() == 'GRAPE')", "find-max": "$.words:filter($w => $w:startsWith('b')):findMax($w => $w:substr(0, 2))", "range": "range(2, 6)", "slice": "$.numbers:slice(2, 5)", "filter": "$.numbers:filter($n => $n >= 10 && $n < 17)", "item": "$.words:item(2)"}, "expect": {"length": 7, "min-number": 2, "min-word": "apple", "find-number": 11, "find-word": "grape", "find-max": "bricks", "range": [2, 3, 4, 5], "slice": [6, 8, 10], "filter": [10, 11, 13, 15], "item": "apple"}, "source": "archive/examples/json/02-arrays.fx.json", "note": "original used the removed name `uppercase` (see B8 cases); ported with `toUpperCase`"},
    {"name": "example 03-advanced.fx.json: user function called per color", "template": {"@foo($)": "$:toUpperCase()", "color": {"red": "@foo('red')", "green": "@foo('green')", "blue": "@foo('blue')"}}, "expect": {"color": {"red": "RED", "green": "GREEN", "blue": "BLUE"}}, "source": "archive/examples/json/03-advanced.fx.json", "note": "original used the removed name `uppercase`"},
    {"name": "example 03-advanced.fx: dynamic keys in an inline object", "template": "{\n    @intersect($obj, $keys): {\n        $filterKeys: $keys:filter($k => $obj[$k] != undefined),\n        [$filterKeys as $k]: $obj[$k]\n    },\n\n    $A: {'foo': 10, 'bar': 20},\n    a: @intersect($A, ['foo', 'bar', 'baz'])\n}", "expect": {"a": {"foo": 10, "bar": 20}}, "source": "archive/examples/json/03-advanced.fx"},
    {"name": "example collection.js: chart templates mapped over data", "template": {"@mapFn($)": {"upperLowerChart": {"upper": "$.someWord:toUpperCase", "lower": "$.someWord:toLowerCase"}, "joinStringsChart": "$.someLetters:join(',')"}, "()": "$data?:map(@mapFn)"}, "inputs": {"$data": [{"someWord": "Hello", "someLetters": ["a", "b", "c"]}, {"someWord": "World!", "someLetters": ["d", "e", "f"]}]}, "expect": [{"upperLowerChart": {"upper": "HELLO", "lower": "hello"}, "joinStringsChart": "a,b,c"}, {"upperLowerChart": {"upper": "WORLD!", "lower": "world!"}, "joinStringsChart": "d,e,f"}], "source": "examples/collection.js + examples/templates/*.json (V1-PLAN.md B17: the comment in collection.js shows 'a,b,c' twice; actual output is 'd,e,f')"},
    {"name": "example collection.js: null data", "template": {"@mapFn($)": {"x": "$.someWord"}, "()": "$data?:map(@mapFn)"}, "inputs": {"$data": null}, "expect": null, "source": "examples/collection.js (?: on null input)"}
  ]
}
