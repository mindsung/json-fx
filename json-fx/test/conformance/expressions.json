{
  "defaults": { "v0": "same", "source": "operator/literal semantics (README, users.spec.ts, fn-*.spec.ts)" },
  "cases": [
    {"name": "number literal", "template": "42", "expect": 42, "tags": ["literal"]},
    {"name": "decimal literal", "template": "9.5 + 0.5", "expect": 10, "tags": ["literal"], "source": "users.spec.ts 'binary operation'"},
    {"name": "string literal", "template": "'hello world'", "expect": "hello world", "tags": ["literal"]},
    {"name": "true literal", "template": "true", "expect": true, "tags": ["literal"]},
    {"name": "false literal", "template": "false", "expect": false, "tags": ["literal"]},
    {"name": "null literal", "template": "null", "expect": null, "tags": ["literal"]},
    {"name": "undefined literal", "template": "undefined", "expect": {"$$undefined": true}, "tags": ["literal"]},
    {"name": "empty string expression is null", "template": "", "expect": null, "tags": ["literal"], "note": "V1-PLAN.md §5.4: empty string -> null, as v0"},
    {"name": "JSON number template", "template": 10, "expect": 10, "tags": ["literal"]},
    {"name": "JSON boolean template", "template": true, "expect": true, "tags": ["literal"]},
    {"name": "JSON null template", "template": null, "expect": null, "tags": ["literal"]},

    {"name": "array literal", "template": "[0, 1, 2, 'A']", "expect": [0, 1, 2, "A"], "tags": ["literal", "array"], "source": "users.spec.ts 'array literal'"},
    {"name": "empty array literal", "template": "[]", "expect": [], "tags": ["literal", "array"]},
    {"name": "nested array literal", "template": "[[1, 2], [3]]", "expect": [[1, 2], [3]], "tags": ["literal", "array"]},
    {"name": "object literal expression", "template": "{ a: 1, b: 'x' }", "expect": {"a": 1, "b": "x"}, "tags": ["literal", "object"]},
    {"name": "object literal with quoted keys", "template": "{ 'sku': 1, 'big total': 2 }", "expect": {"sku": 1, "big total": 2}, "tags": ["literal", "object"], "source": "bench fixture (V1-PLAN.md App. C)"},

    {"name": "precedence: multiplication over addition", "template": "1 + 2 * 3", "expect": 7, "tags": ["precedence"]},
    {"name": "precedence: parentheses", "template": "(1 + 2) * 3", "expect": 9, "tags": ["precedence"]},
    {"name": "subtraction is left associative", "template": "10 - 4 - 3", "expect": 3, "tags": ["precedence"]},
    {"name": "division is left associative", "template": "100 / 10 / 5", "expect": 2, "tags": ["precedence"]},
    {"name": "power is right associative", "template": "2 ** 3 ** 2", "expect": 512, "tags": ["precedence"]},
    {"name": "power binds tighter than multiplication", "template": "2 * 3 ** 2", "expect": 18, "tags": ["precedence"]},
    {"name": "modulus", "template": "7 % 4", "expect": 3, "tags": ["operator"]},
    {"name": "comparison binds looser than addition", "template": "1 + 1 == 2", "expect": true, "tags": ["precedence"]},
    {"name": "&& binds tighter than ||", "template": "true || false && false", "expect": true, "tags": ["precedence"]},
    {"name": "|| and && with comparisons", "template": "1 < 2 && 3 > 2 || false", "expect": true, "tags": ["precedence"]},

    {"name": "unary minus on literal", "template": "-10", "expect": -10, "tags": ["unary"], "source": "users.spec.ts 'unary (-)'"},
    {"name": "unary minus after operator", "template": "2 * -10", "expect": -20, "tags": ["unary"], "source": "users.spec.ts 'unary (-)'"},
    {"name": "unary minus on group", "template": "2 * -(5 + 5)", "expect": -20, "tags": ["unary"], "source": "users.spec.ts 'unary (-)'"},
    {"name": "unary minus binds to the base of **", "template": "-2 ** 2", "expect": 4, "tags": ["unary", "precedence"], "note": "V1-PLAN.md §4.3/§7.2: (-2) ** 2, matches v0 (JS would reject it, Python gives -4)"},
    {"name": "not", "template": "!false", "expect": true, "tags": ["unary"]},
    {"name": "not not", "template": "!!true", "expect": true, "tags": ["unary"]},
    {"name": "not on comparison needs parentheses", "template": "!(1 == 2)", "expect": true, "tags": ["unary"]},

    {"name": "loose equality", "template": "1 == '1'", "expect": true, "tags": ["operator"], "note": "eq is JS =="},
    {"name": "strict equality", "template": "1 === '1'", "expect": false, "tags": ["operator"]},
    {"name": "loose inequality", "template": "1 != '1'", "expect": false, "tags": ["operator"]},
    {"name": "strict inequality", "template": "1 !== '1'", "expect": true, "tags": ["operator"]},
    {"name": "null equals undefined (loose)", "template": "null == undefined", "expect": true, "tags": ["operator"]},
    {"name": "null does not equal 0", "template": "null == 0", "expect": false, "tags": ["operator"], "source": "fn-comparative.spec.ts"},
    {"name": "greater/less comparisons", "template": "[1 > 0, 1 >= 1, 1 < 2, 2 <= 1]", "expect": [true, true, true, false], "tags": ["operator"]},
    {"name": "string concatenation with numbers", "template": "'a' + 1 + 2", "expect": "a12", "tags": ["operator"]},
    {"name": "string concat of three parts", "template": "'hello' + ' ' + 'world'", "expect": "hello world", "tags": ["operator"]},

    {"name": "|| returns the operand value", "template": "'x' || 'y'", "expect": "x", "tags": ["logical"], "note": "V1-PLAN.md §7.2"},
    {"name": "|| falls through falsy", "template": "null || 0 || 'z'", "expect": "z", "tags": ["logical"]},
    {"name": "&& returns the operand value", "template": "'x' && 'y'", "expect": "y", "tags": ["logical"]},
    {"name": "&& stops at first falsy", "template": "0 && 'y'", "expect": 0, "tags": ["logical"]},

    {"name": "if/else expression true branch", "template": "'yes' if 1 < 2 else 'no'", "expect": "yes", "tags": ["conditional"]},
    {"name": "if/else expression false branch", "template": "'yes' if 1 > 2 else 'no'", "expect": "no", "tags": ["conditional"]},
    {"name": "ifElse function", "template": "ifElse(1 < 2, 'yes', 'no')", "expect": "yes", "tags": ["conditional"]},
    {"name": "ifElse does not evaluate the untaken branch", "template": "ifElse(true, 1, throw('boom'))", "expect": 1, "tags": ["conditional", "lazy"]},
    {"name": "ifElse without else returns undefined", "template": "ifElse(false, 1)", "expect": {"$$undefined": true}, "tags": ["conditional"]},
    {"name": "catch returns value when no error", "template": "catch(1 + 1, 'fallback')", "expect": 2, "tags": ["error"]},
    {"name": "catch returns fallback on error", "template": "catch(throw('boom'), 'fallback')", "expect": "fallback", "tags": ["error"]},
    {"name": "catch without fallback returns null", "template": "catch(throw('boom'))", "expect": null, "tags": ["error"]},
    {"name": "throw raises its message", "template": "throw('boom')", "expectError": {"match": "boom", "phase": "run"}, "tags": ["error"]},
    {"name": "notNull passes values through", "template": "notNull(5)", "expect": 5, "tags": ["error"]},
    {"name": "notNull throws on null", "template": "notNull(null)", "expectError": {"match": "null", "phase": "run"}, "tags": ["error"]},
    {"name": "ifNull", "template": "[ifNull(null, 'd'), ifNull(0, 'd'), ifNull(undefined, 'd')]", "expect": ["d", 0, {"$$undefined": true}], "tags": ["conditional"]},
    {"name": "ifNullOrUndefined", "template": "[ifNullOrUndefined(null, 'd'), ifNullOrUndefined(undefined, 'd'), ifNullOrUndefined(5, 'd')]", "expect": ["d", "d", 5], "tags": ["conditional"]},

    {"name": "math namespace function", "template": "math~floor(7.9)", "expect": 7, "tags": ["function"], "source": "README string expressions"},
    {"name": "math namespace constant as bare word", "template": "math~floor(math~PI)", "expect": 3, "tags": ["function", "bare-word"], "note": "bare word naming a registered function is a zero-argument call (V1-PLAN.md §4.4)"},
    {"name": "function call syntax and chain syntax are equivalent", "template": "[add(1, 2), 1:add(2)]", "expect": [3, 3], "tags": ["function", "invoke"], "source": "README functions and operators"},
    {"name": "chained call without parentheses", "template": "1:add(2):toString", "expect": "3", "tags": ["function", "invoke"], "source": "README functions and operators"},
    {"name": "value literals with chain on group", "template": "(1.5 + 3):toString + ['hello', 2, true, null]:first", "expect": "4.5hello", "tags": ["function", "invoke"], "source": "README value literals"},

    {"name": "lambda with parenthesized parameter", "template": "[2, 4, 6, 8]:find(($n) => $n > 5)", "expect": 6, "tags": ["lambda"], "source": "README lambda"},
    {"name": "lambda with bare parameter", "template": "[1, 2, 3]:map($n => $n * 2)", "expect": [2, 4, 6], "tags": ["lambda"]},
    {"name": "lambda with two parameters", "template": "[1, 2, 3, 4]:reduce(($acc, $n) => $acc + $n, 0)", "expect": 10, "tags": ["lambda"]},
    {"name": "for/in comprehension", "template": "$x * 2 for $x in [1, 2, 3]", "expect": [2, 4, 6], "tags": ["lambda", "comprehension"], "note": "lowers to map (V1-PLAN.md §5.3)"},
    {"name": "lambda closes over outer parameter", "template": "[1, 2]:map($a => [10, 20]:map($b => $a + $b))", "expect": [[11, 21], [12, 22]], "tags": ["lambda", "scope"]},
    {"name": "lambda argument null normalization", "template": "[undefined]:map($x => $x == null)", "expect": [true], "tags": ["lambda"], "note": "undefined args become null (decided: keep, §10 Q5)"},
    {"name": "lambda argument undefined is null not undefined", "template": "[undefined]:map($x => $x === null)", "expect": [true], "tags": ["lambda"], "note": "§10 Q5: undefined -> null normalization"}
  ]
}
