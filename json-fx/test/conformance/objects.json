{
  "defaults": { "v0": "same", "source": "object templates, scopes, user functions (README, users.spec.ts, dynamic-field.spec.ts)" },
  "cases": [
    {"name": "empty object template", "template": {}, "expect": {}, "tags": ["object"]},
    {"name": "constant members pass through", "template": {"a": 1, "b": [1, 2], "c": {"d": true}, "e": null}, "expect": {"a": 1, "b": [1, 2], "c": {"d": true}, "e": null}, "tags": ["object"]},
    {"name": "string members are expressions", "template": {"someProp": "$ + 1", "anotherProp": {"deeperProp": "$ * 2"}}, "inputs": {"$": 5}, "expect": {"someProp": 6, "anotherProp": {"deeperProp": 10}}, "tags": ["object"], "source": "README object expressions"},
    {"name": "array template evaluates its elements", "template": ["$ + 1", 2, {"a": "$ * 2"}], "inputs": {"$": 5}, "expect": [6, 2, {"a": 10}], "tags": ["object", "array"]},
    {"name": "comment keys are skipped", "template": {"//": "ignored", "// another": "ignored", "a": 1}, "expect": {"a": 1}, "tags": ["object", "comment"]},
    {"name": "keys keep declaration order", "template": {"z": 1, "a": 2, "m": 3}, "expect": {"z": 1, "a": 2, "m": 3}, "tags": ["object"]},
    {"name": "key whose value is undefined is present", "template": {"a": "$.missing"}, "inputs": {"$": {}}, "expect": {"a": {"$$undefined": true}}, "tags": ["object"], "note": "V1-PLAN.md §7.2: undefined-valued keys are present"},

    {"name": "variable reference", "template": {"$a": 10, "()": "$a"}, "expect": 10, "tags": ["variable"], "source": "users.spec.ts"},
    {"name": "nested variable reference", "template": {"$a": 10, "$b": "$a + 10", "()": "$b"}, "expect": 20, "tags": ["variable"], "source": "users.spec.ts"},
    {"name": "variable declaration order is irrelevant", "template": {"$b": "$a + 10", "$a": 10, "()": "$b"}, "expect": 20, "tags": ["variable"]},
    {"name": "variables are not output", "template": {"$a": 1, "b": "$a"}, "expect": {"b": 1}, "tags": ["variable"]},
    {"name": "variables with constant values", "template": {"$pi": 3.14159, "$radiusSquared": "$radius * $radius", "radius": "$radius", "area": "($pi * $radiusSquared * 100):math~round / 100"}, "inputs": {"$radius": 3}, "expect": {"radius": 3, "area": 28.27}, "tags": ["variable"], "source": "README variables"},
    {"name": "variable value may be an object template", "template": {"$o": {"a": "1 + 1"}, "()": "$o.a"}, "expect": 2, "tags": ["variable"]},
    {"name": "inner variable sees outer variable", "template": {"$a": 1, "inner": {"$b": "$a + 1", "v": "$b"}}, "expect": {"inner": {"v": 2}}, "tags": ["variable", "scope"]},
    {"name": "inner variable shadows outer variable", "template": {"$a": 1, "inner": {"$a": 2, "v": "$a"}, "outer": "$a"}, "expect": {"inner": {"v": 2}, "outer": 1}, "tags": ["variable", "scope"], "note": "V1-PLAN.md §4.4 lexical scoping"},
    {"name": "unused variable is never evaluated", "template": {"$bad": "throw('never')", "()": 1}, "expect": 1, "tags": ["variable", "lazy"], "note": "V1-PLAN.md §4.4: lazy variables"},
    {"name": "variable evaluated once per evaluation", "template": {"$t": "tick(5)", "()": "$t + $t"}, "functions": ["tick"], "expect": 10, "expectCalls": {"tick": 1}, "tags": ["variable", "lazy"]},
    {"name": "variable shadows an input of the same name", "template": {"$": {"a": 10}, "()": "$.a"}, "inputs": {"$": {"a": 99}}, "expect": 10, "tags": ["variable", "scope"], "source": "archive/examples 01-basic.fx.json declares \"$\""},

    {"name": "template function without arguments", "template": {"@templ": 50, "()": "@templ()"}, "expect": 50, "tags": ["function"], "source": "users.spec.ts"},
    {"name": "template function with argument", "template": {"@templ($)": "$ + 10", "()": "@templ(10)"}, "expect": 20, "tags": ["function"], "source": "users.spec.ts"},
    {"name": "nested template function calls", "template": {"@A($)": "$ + 10", "@B($)": "@A($) + 20", "()": "@B(10)"}, "expect": 40, "tags": ["function"], "source": "users.spec.ts"},
    {"name": "inline object literal with variable and function", "template": "{ $a: 10, @templ($): $ * 2, (): @templ($a) }", "expect": 20, "tags": ["function", "object"], "source": "users.spec.ts"},
    {"name": "template function with two arguments", "template": {"@rectArea($length, $width)": "$length * $width", "area": "@rectArea($.length, $.width)"}, "inputs": {"$": {"length": 3, "width": 4}}, "expect": {"area": 12}, "tags": ["function"], "source": "README user-defined functions"},
    {"name": "template function passed as argument", "template": {"@isBigNumber($n)": "$n >= 100", "$numbers": [50, 75, 100, 200], "firstBigNumber": "$numbers:find(@isBigNumber)"}, "expect": {"firstBigNumber": 100}, "tags": ["function", "callable"], "source": "README user-defined functions"},
    {"name": "template function used with map", "template": {"@mapped($p)": {"name": "$p.first + ' ' + $p.last"}, "()": "$:map(@mapped)"}, "inputs": {"$": [{"first": "A", "last": "B"}]}, "expect": [{"name": "A B"}], "tags": ["function", "callable"], "source": "README example 2"},
    {"name": "callable parameter", "template": {"@twice($x, @f)": "@f(@f($x))", "@inc($n)": "$n + 1", "()": "@twice(1, @inc)"}, "expect": 3, "tags": ["function", "callable"], "source": "misc-debug.spec.ts (@valueExpr parameter)"},
    {"name": "function declared after use", "template": {"rectInfo": {"area": "@rectArea($.length, $.width)"}, "@rectArea($length, $width)": "$length * $width"}, "inputs": {"$": {"length": 3, "width": 4}}, "expect": {"rectInfo": {"area": 12}}, "tags": ["function", "scope"], "source": "README variable and user-defined function scope"},
    {"name": "function body variable evaluated once per call", "template": {"@f($x)": {"$y": "tick($x)", "()": "$y + $y"}, "()": "@f(1) + @f(2)"}, "functions": ["tick"], "expect": 6, "expectCalls": {"tick": 2}, "tags": ["function", "lazy"], "note": "V1-PLAN.md §4.4: once per invocation for vars inside a function body"},
    {"name": "recursive function", "template": {"@f($n)": "ifElse($n <= 1, 1, @f($n - 1) * $n)", "()": "@f($)"}, "inputs": {"$": 5}, "expect": 120, "tags": ["function", "recursion"], "v0": "differs", "change": "B", "bug": "B2", "v0Actual": 1},
    {"name": "mutually recursive functions", "template": {"@even($n)": "ifElse($n == 0, true, @odd($n - 1))", "@odd($n)": "ifElse($n == 0, false, @even($n - 1))", "()": "@even($)"}, "inputs": {"$": 10}, "expect": true, "tags": ["function", "recursion"], "note": "V1-PLAN.md §4.4: mutually recursive functions allowed (v0 happens to get this one right)"},

    {"name": "value promotion", "template": {"$pi": 3.14159, "@area($radius)": "$pi * $radius:pow(2)", "()": "@area($)"}, "inputs": {"$": 3}, "expect": 28.27431, "tags": ["promotion"], "source": "README object value promotion"},
    {"name": "value promotion in a nested object", "template": {"outer": {"$x": 2, "()": "$x * 3"}}, "expect": {"outer": 6}, "tags": ["promotion"], "source": "README object value promotion"},
    {"name": "value promotion with constant", "template": {"()": 10}, "expect": 10, "tags": ["promotion"], "source": "users.spec.ts"},
    {"name": "value promotion with false", "template": {"()": false}, "expect": false, "tags": ["promotion"], "source": "users.spec.ts"},
    {"name": "value promotion with null", "template": {"()": null}, "expect": null, "tags": ["promotion"], "source": "users.spec.ts"},
    {"name": "value promotion alongside output keys is an error", "template": {"()": 1, "a": 2}, "expectError": {"type": "FxCompileError", "phase": "compile"}, "tags": ["promotion", "error"], "note": "V1-PLAN.md §5.4: compile-time error (v0 threw at run time; phase only checked by strict engines)", "change": "A"},

    {"name": "dynamic key: constant", "template": {"{ 'A' }": 0}, "expect": {"A": 0}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "Invalid object literal, expected key-value pairs"},
    {"name": "dynamic key: constant with binding", "template": {"{ 'A' as $ }": "$"}, "expect": {"A": "A"}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: array literal", "template": {"{ ['A', 'B', 'C'] as $v, $i }": "$v:toLowerCase() + $i"}, "expect": {"A": "a0", "B": "b1", "C": "c2"}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: object literal ($v = value, $k = key)", "template": {"{ {a:10, b:20, c:30} as $v, $k }": "$k + $v"}, "expect": {"a": "a10", "b": "b20", "c": "c30"}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts; §10 Q7", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: variable source", "template": {"$var": "'a'", "{ $var as $ }": "$:toUpperCase()"}, "expect": {"a": "A"}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: function call source", "template": {"@tem($)": "$:toUpperCase()", "{ @tem('hello') as $ }": "$:toLowerCase():toTitleCase()"}, "expect": {"HELLO": "Hello"}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: expression source", "template": {"$arr": [2, 4, 8], "{$arr:map($ => $ ** 2) as $}": "$ ** 0.5"}, "expect": {"4": 2, "16": 4, "64": 8}, "tags": ["dynamic-key"], "source": "dynamic-field.spec.ts", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: object source copies entries", "template": {"$u": {"a": 1, "b": 2}, "{ $u as $ }": "$"}, "expect": {"a": 1, "b": 2}, "tags": ["dynamic-key"], "source": "users.spec.ts [sanitizer]", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key: scalar source", "template": {"{ 5 as $v }": "$v + 1"}, "expect": {"5": 6}, "tags": ["dynamic-key"], "note": "V1-PLAN.md §5.4: any other value -> single key String(value)", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "dynamic key mixes with static keys", "template": {"first": 1, "{ ['x', 'y'] as $v }": "$v", "last": 2}, "expect": {"first": 1, "x": "x", "y": "y", "last": 2}, "tags": ["dynamic-key"], "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "\"as\" is only valid within a dynamic key declaration"},
    {"name": "inline object literal with array-style dynamic key", "template": "{ $keys: ['a', 'b'], [$keys as $k]: $k + '!' }", "expect": {"a": "a!", "b": "b!"}, "tags": ["dynamic-key"], "source": "archive/examples 03-advanced.fx syntax"},

    {"name": "optional key omitted when null", "template": {"nick?": "$.n"}, "inputs": {"$": {"n": null}}, "expect": {}, "tags": ["optional-key"], "v0": "differs", "change": "C", "bug": "B10", "v0Actual": {"nick?": null}},
    {"name": "optional key omitted when undefined", "template": {"nick?": "$.n"}, "inputs": {"$": {}}, "expect": {}, "tags": ["optional-key"], "v0": "differs", "change": "C", "bug": "B10", "v0Actual": {"nick?": {"$$undefined": true}}},
    {"name": "optional key emitted without the ?", "template": {"nick?": "$.n"}, "inputs": {"$": {"n": "x"}}, "expect": {"nick": "x"}, "tags": ["optional-key"], "v0": "differs", "change": "C", "bug": "B10", "v0Actual": {"nick?": "x"}},
    {"name": "optional key keeps falsy non-null values", "template": {"a?": "$.a", "b?": "$.b", "c?": "$.c"}, "inputs": {"$": {"a": 0, "b": false, "c": ""}}, "expect": {"a": 0, "b": false, "c": ""}, "tags": ["optional-key"], "v0": "differs", "change": "C", "bug": "B10", "v0Actual": {"a?": 0, "b?": false, "c?": ""}},
    {"name": "literal key ending in ? via constant dynamic key", "template": {"{ 'nick?' }": "$.n"}, "inputs": {"$": {"n": 1}}, "expect": {"nick?": 1}, "tags": ["optional-key", "dynamic-key"], "note": "V1-PLAN.md §5.4 rule 6", "v0": "differs", "change": "A", "bug": "B9", "v0ActualError": "Invalid object literal, expected key-value pairs"},
    {"name": "plain keys are used verbatim", "template": {"a b": 1, "a-b": 2, "a.b": 3, "1": 4}, "expect": {"1": 4, "a b": 1, "a-b": 2, "a.b": 3}, "tags": ["object"], "note": "integer-like keys sort first (JS ordering, V1-PLAN.md §4.4)"},

    {"name": "variable cycle is an error", "template": {"$a": "$b", "$b": "$a", "()": "$a"}, "expectError": {"type": "FxCompileError", "phase": "compile"}, "tags": ["variable", "error"], "change": "A", "bug": "B11", "note": "v0 overflows the stack at run time; both throw (error type/phase only checked by strict engines)"},
    {"name": "self-referencing variable is an error", "template": {"$a": "$a + 1", "()": "$a"}, "expectError": {"type": "FxCompileError", "phase": "compile"}, "tags": ["variable", "error"], "change": "A", "bug": "B11"},
    {"name": "recursion through a function is allowed", "template": {"@f($n)": "ifElse($n <= 0, 0, @f($n - 1))", "$v": "@f(3)", "()": "$v"}, "expect": 0, "tags": ["variable", "recursion"], "note": "V1-PLAN.md §4.4: cycles through functions are allowed", "v0": "same"},
    {"name": "unresolved template function is an error", "template": "@a", "expectError": {"type": "FxCompileError", "phase": "compile"}, "tags": ["error"], "source": "users.spec.ts 'undefined template'"}
  ]
}
